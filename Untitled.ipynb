   "source": [
    "import sys\n",
    "sys.path.append(\"...\")\n",
    "from simulations.credit import prob_at_least_k_defaults"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "f17ab12a-3bcc-4270-9cda-79add21bf664",
   "metadata": {
    "scrolled": true
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "import numpy as np\n",
      "import math\n",
      "\n",
      "\n",
      "def _default_for_x_clients(n_loans: int, p_default: float, x: int) -> float:\n",
      "    \"\"\"Probability that exactly x out of n_loans clients default.\"\"\"\n",
      "    n_ways = math.comb(n_loans,x)\n",
      "    p_x = n_ways * p_default**(x)*(1-p_default)**(n_loans-x)\n",
      "    return p_x\n",
      "\n",
      "def prob_at_least_one_default(n_loans: int, p_default: float) -> float:\n",
      "    \"\"\" Probability of at least one default. \"\"\"\n",
      "    prob_no_default = _default_for_x_clients(n_loans, p_default,0)\n",
      "    return 1 - prob_no_default\n",
      "\n",
      "def default_count_pmf(n_loans: int,p_default :float) -> np.ndarray :\n",
      "    \"\"\"Probability of exactly k defaults for each k = 0, ..., n_loans.\"\"\"\n",
      "    probs = []\n",
      "    for k in range(n_loans+1):\n",
      "        prob = _default_for_x_clients(n_loans,p_default,k)\n",
      "        probs.append(prob)\n",
      "    return np.array(probs)\n",
      "\n",
      "def prob_at_least_k_defaults(n_loans: int, p_default: float, k: int) -> float:\n",
      "    \"\"\"Probability of at least k defaults among n_loans loans.\"\"\"\n",
      "    pmf = default_count_pmf(n_loans, p_default)\n",
      "    return pmf[k:].sum()\n",
      "\n",
      "def expected_credit_loss(n_loans :int, p_default :float, ead :float, lgd :float) -> float:\n",
      "    \"\"\" Calculating expected credit loss for n_loans. \"\"\"\n",
      "    exp_loss = n_loans * p_default * ead * lgd\n",
      "    return exp_loss\n",
      "\n"
     ]
    }
   ],
   "source": [
    "print(open(\"simulations/credit.py\", encoding=\"utf-8\").read())"
   ]
